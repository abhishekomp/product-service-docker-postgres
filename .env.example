# .env.example — copy this file to .env and fill in your values.
# .env is git-ignored and must NEVER be committed.
#
# Usage:
#   cp .env.example .env
#   # then edit .env with your actual password
#
# Docker Compose reads .env automatically when you run:
#   docker compose up

# Password for the PostgreSQL container.
# Used by both the postgres service and the backend service in docker-compose.yaml.
POSTGRES_DB_PWD=changeme

